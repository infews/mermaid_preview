#!/usr/bin/env ruby
# frozen_string_literal: true

#
# mmd-preview — live browser preview of a Mermaid diagram with your own CSS.
#
# Usage:
#   mmd-preview DIAGRAM.mmd [STYLE.css] [options]
#
# Ctrl-C to stop; the temp dir is removed on exit.
#
# The only place in the tool that is allowed to exit.

gemfile = File.expand_path("../Gemfile", __dir__)
if File.file?(gemfile)
  ENV["BUNDLE_GEMFILE"] ||= gemfile
  require "bundler/setup"
end

require_relative "../lib/mermaid_preview"

begin
  MermaidPreview::Session.new(MermaidPreview::CLI.parse(ARGV)).run
rescue MermaidPreview::HelpRequested => e
  puts e.message
rescue MermaidPreview::Error => e
  abort e.message
rescue Interrupt
  exit 130
end
